# Copy to .env; keep actual credentials and runtime data out of Git.
GIZMOAPP_SHELL=text
GIZMOAPP_ENV=development
GIZMOAPP_PORT=8001
GIZMOAPP_URL_PREFIX=
GIZMOAPP_DB_PATH=var/data/gizmoapp.sqlite3
GIZMOAPP_SECRET_KEY=change-me-before-production

# Set these on the server before enabling live AI replies.
GIZMO_LLM_API_KEY=
GIZMO_LLM_BASE_URL=
GIZMO_LLM_MODEL=
GIZMO_LLM_TIMEOUT_SECONDS=45
GIZMO_WEB_SEARCH_ENABLED=1
GIZMO_WEB_SEARCH_MAX_CALLS=2

# Verified email sender and public invitation destination.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GIZMOAPP_PUBLIC_URL=https://debate-agora.beringtech.com
GIZMO_ACCOUNT_STARTER_REPLIES=50
GIZMO_ACCOUNT_INVITE_REWARD=100
